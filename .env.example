# FACEIT Data API credentials (server-side only)
APP_ID=
API_KEY=
API_KEY_NAME=
FACEIT_OWNER_NICKNAME=Christian976

# Owner-only alias controls. Use long, random values in production.
OWNER_ACCESS_TOKEN=
SESSION_SECRET=

# Optional. Defaults to ./data and should be persisted by your host.
DATA_DIR=./data

# Optional. Enables POST /api/webhooks/faceit so FACEIT App Studio webhooks can announce
# matches the moment they start. The header name and value must match the webhook's
# security settings in App Studio. Leave the secret empty to disable the endpoint.
FACEIT_WEBHOOK_SECRET=
FACEIT_WEBHOOK_HEADER=x-webhook-secret

# Optional. Upstash Redis REST credentials. Required on Vercel (serverless instances don't
# share memory or disk) so webhook matches and aliases persist. The Vercel Marketplace
# Upstash integration sets KV_REST_API_URL and KV_REST_API_TOKEN for you.
KV_REST_API_URL=
KV_REST_API_TOKEN=
